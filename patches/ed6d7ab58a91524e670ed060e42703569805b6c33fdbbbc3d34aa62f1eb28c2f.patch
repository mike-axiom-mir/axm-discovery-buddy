+name: Discovery Capability Query
+
+on:
+  pull_request:
+    paths:
+      - 'discovery_buddy/**'
+      - 'tests/test_query.py'
+      - 'tests/test_scanner.py'
+      - 'docs/DISCOVERY_QUERY.md'
+      - '.github/workflows/discovery-capability-query.yml'
+      - 'README.md'
+  push:
+    branches: [main]
+    paths:
+      - 'discovery_buddy/**'
+      - 'tests/test_query.py'
+      - 'tests/test_scanner.py'
+      - 'docs/DISCOVERY_QUERY.md'
+      - '.github/workflows/discovery-capability-query.yml'
+      - 'README.md'
+
+permissions:
+  contents: read
+
+jobs:
+  query:
+    runs-on: ubuntu-latest
+    strategy:
+      matrix:
+        python-version: ['3.11', '3.13']
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python-version }}
+      - name: Compile dependency-free package
+        run: python -m compileall -q discovery_buddy tests/test_query.py tests/test_scanner.py
+      - name: Query and scanner regressions
+        run: python -m unittest -v tests/test_query.py tests/test_scanner.py
+      - name: Real scan to query bridge
+        run: |
+          python - <<'PY'
+          import json
+          from pathlib import Path
+          import subprocess
+          import sys
+          import tempfile
+
+          with tempfile.TemporaryDirectory() as tmp:
+              root = Path(tmp) / "workspace"
+              repo = root / "provider"
+              out = Path(tmp) / "out"
+              (repo / ".git" / "refs" / "heads").mkdir(parents=True)
+              (repo / ".git" / "HEAD").write_text("ref: refs/heads/main\n", "ascii")
+              (repo / ".git" / "refs" / "heads" / "main").write_text("a" * 40 + "\n", "ascii")
+              (repo / ".axm").mkdir()
+              (repo / ".axm" / "discovery-public.json").write_text(json.dumps({
+                  "schema": "axm.discovery-public/v1",
+                  "public": True,
+                  "repo": "smoke/provider",
+                  "display_name": "Smoke Provider",
+              }) + "\n", "utf-8")
+              (repo / "registry").mkdir()
+              (repo / "registry" / "capabilities.jsonl").write_text(json.dumps({
+                  "id": "axm.smoke.capability/v1",
+                  "providers": ["smoke.cli"],
+                  "consumers": [],
+                  "status": "TEST",
+              }, sort_keys=True) + "\n", "utf-8")
+
+              subprocess.run([
+                  sys.executable, "-m", "discovery_buddy", "scan", str(root),
+                  "--output-dir", str(out), "--public",
+              ], check=True)
+              subprocess.run([
+                  sys.executable, "-m", "discovery_buddy", "verify", str(root),
+                  "--output-dir", str(out), "--public",
+              ], check=True)
+              result = subprocess.run([
+                  sys.executable, "-m", "discovery_buddy", "query", str(out / "public-discovery.json"),
+                  "--capability-id", "axm.smoke.capability/v1", "--provider", "smoke.cli",
+              ], check=True, capture_output=True, text=True)
+              payload = json.loads(result.stdout)
+              assert payload["summary"] == {"matches": 1}
+              assert payload["candidates"][0]["repository"] == "smoke/provider"
+              assert payload["authority"]["classification"] == "DISCOVERY_EVIDENCE_ONLY"
+              assert all(payload["authority"][key] is False for key in ("execute", "install", "select", "merge", "canon"))
+          PY
