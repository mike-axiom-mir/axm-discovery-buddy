+name: Discovery Map Viewer
+
+on:
+  pull_request:
+    paths:
+      - 'viewer/**'
+      - '.github/workflows/discovery-map-viewer.yml'
+      - 'discovery_buddy/**'
+      - 'tests/test_scanner.py'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  viewer-contract:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.11'
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+      - name: Scanner contract
+        run: python -m unittest -v tests/test_scanner.py
+      - name: Viewer model contract
+        run: node --test viewer/discovery-map.test.mjs
+      - name: JavaScript syntax
+        run: node --check viewer/discovery-map.mjs
